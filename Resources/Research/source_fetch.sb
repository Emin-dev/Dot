(version 1)
; Separate short-lived native reader. No models, launcher, application data, user
; files, state directories, DNS, inbound sockets, proxies or trust-daemon egress.
; The host supplies one already-connected, vetted socket as stdin. There is no
; network exception: the reader cannot connect, reconnect or choose another peer,
; and the shipped binary contains no socket()/connect()/resolver call site.
; The only executable is the reader itself: no interpreter, no scripts.
(allow default)
(deny file-read*)
(deny file-map-executable)
(deny file-write*)
(deny network*)
(deny process-exec)
(allow process-exec (literal (param "DOT_SOURCE_HELPER")))
(allow file-read-metadata
  (path-ancestors (param "DOT_SOURCE_HELPER"))
  (literal "/etc") (literal "/var") (literal "/tmp"))
(allow file-read*
  (literal "/")
  (subpath "/System/Library") (subpath "/Library/Apple/System")
  (subpath "/usr/lib")
  (literal "/private/etc/ssl/cert.pem") (literal "/etc/ssl/cert.pem")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom")
  (literal (param "DOT_SOURCE_HELPER")))
(allow file-map-executable
  (subpath "/System/Library") (subpath "/Library/Apple/System") (subpath "/usr/lib")
  (literal (param "DOT_SOURCE_HELPER")))
(allow file-write-data (literal "/dev/null"))
