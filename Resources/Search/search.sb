(version 1)
; Candidate Search-only policy. Exact-artifact macOS canaries must pass before
; admission. No inference, model, document, screen or voice path is granted.
(deny default)
(allow process-fork)
(allow process-exec (literal (param "DOT_SEARCH_PYTHON")))
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read-metadata
  (path-ancestors (param "DOT_SEARCH_PAYLOAD"))
  (path-ancestors (param "DOT_SEARCH_STATE"))
  (literal "/") (literal "/tmp") (literal "/var") (literal "/etc"))
(allow file-read*
  (subpath (param "DOT_SEARCH_PAYLOAD"))
  (subpath (param "DOT_SEARCH_STATE"))
  (subpath "/System/Library") (subpath "/Library/Apple/System")
  (subpath "/usr/lib") (subpath "/usr/share/locale")
  (subpath "/private/var/db/dyld") (subpath "/private/var/db/timezone")
  (literal "/private/etc/localtime")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-map-executable
  (subpath (string-append (param "DOT_SEARCH_PAYLOAD") "/python"))
  (subpath "/System/Library") (subpath "/Library/Apple/System") (subpath "/usr/lib"))
(allow file-write* (subpath (param "DOT_SEARCH_STATE")))
(allow file-write-data (literal "/dev/null"))
; The listener was already bound once by the native bootstrap. No network-bind
; permission, wildcard listening, second listener, IPv6 or generic LAN connection.
(allow network-inbound
  (require-all (socket-domain AF_INET) (local tcp (param "DOT_SEARCH_LISTENER"))))
; The Swift owner holds this one broker port throughout the generation.
; The actual sockets use numeric 127.0.0.1; localhost is Seatbelt syntax only.
; No helper DNS, direct origin, UDP, IPv6 or other loopback endpoint is granted.
(allow network-outbound
  (require-all (socket-domain AF_INET) (remote tcp (param "DOT_SEARCH_EGRESS"))))
