{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "autoupdate": "notify",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/home/emin/dev/agent/**": "allow",
      "/home/emin/.config/opencode/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "git branch --delete*": "deny",
      "rm -rf /*": "deny"
    }
  }
}
